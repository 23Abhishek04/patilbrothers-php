Options -Indexes
DirectoryIndex index.php
RewriteEngine On
# Serve existing files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Clean URL routes to index.php files, including nested service pages
RewriteRule ^services/([^/]+)/?$ services/$1/index.php [L,QSA,NC]
RewriteRule ^(about|services|gallery|contact)/?$ $1/index.php [L,QSA,NC]
